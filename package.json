{
  "name": "@medyll/svelte-5-documentor",
  "version": "1.0.0",
  "description": "A Svelte 5 component/documentation generator that extracts JSDoc comments and component metadata to create comprehensive documentation for Svelte components.",
  "license": "Unlicense",
  "author": "Lebrun Meddy",
  "public": true,
  "bin": {
    "svelte-5-documentor": "./dist/documentor.js"
  },
  "scripts": {
    "start": "gro dev",
    "dev": "vite dev",
    "package": "svelte-kit sync && svelte-package",
    "build": "vite build && npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.14.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "semantic-release": "^25.0.2",
    "svelte": "^5.49.1",
    "svelte-check": "^4.3.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "uvu": "^0.5.6",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zimmerframe": "^1.1.4"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "useTabs": true,
    "printWidth": 100,
    "singleQuote": true,
    "bracketSpacing": false,
    "overrides": [
      {
        "files": "package.json",
        "options": {
          "useTabs": false
        }
      }
    ]
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "glob": "^13.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "."
  }
}
